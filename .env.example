# Backend Configuration

# Signs sign-in tokens. Generate with: openssl rand -hex 32
# Left empty, the API uses a random key for each run (everyone is signed out on restart).
JWT_SECRET_KEY=

# The first admin account. Without ADMIN_PASSWORD, a random password is printed on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=


# Email Configuration (Optional - for scheduled reports and notifications)
# For Gmail, you must use an App Password (see EMAIL_SETUP_GUIDE.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend Configuration (Optional)
VITE_API_URL=http://127.0.0.1:8000

# Database Configuration (Optional - defaults to SQLite)
# For production, consider using PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/voice_audit
