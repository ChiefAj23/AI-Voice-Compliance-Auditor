# Copy to .env (or export in the service's environment). See README.md, "Security and configuration".

# development | production. Production refuses to start without JWT_SECRET_KEY.
APP_ENV=development

# Signs sign-in tokens. Generate with: openssl rand -hex 32
# Left empty outside production, the API uses a random key for each run (everyone is signed out on restart).
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The first administrator, created at first start. With no password set, a one-time password is
# generated and printed to the server log. Either way it must be changed at the first sign-in.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Accounts are created by administrators unless this is true. Either way a new account has no role
# until an administrator grants one.
ALLOW_SELF_REGISTRATION=false
# The database reset endpoint stays off unless this is true.
ALLOW_DB_RESET=false
MIN_PASSWORD_LENGTH=12

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limits (count/period). Set TRUST_PROXY_HEADERS=true only behind a reverse proxy you control.
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMITING_ENABLED=true
TRUST_PROXY_HEADERS=false

# Any SQLAlchemy URL; the default is the SQLite file at data/analyses.db.
# DATABASE_URL=postgresql://user:password@localhost/voice_audit
DATABASE_URL=

# Outgoing email for notifications and scheduled reports (Gmail needs an app password; see docs/EMAIL_SETUP_GUIDE.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Front end: where the API is.
VITE_API_URL=http://127.0.0.1:8000
