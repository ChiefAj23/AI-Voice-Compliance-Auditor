# Backend Configuration

# JWT Secret Key (REQUIRED in production - generate a secure random string)
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=your-very-secure-secret-key-here-change-in-production

# Email Configuration (Optional - for scheduled reports and notifications)
# For Gmail, you must use an App Password (see EMAIL_SETUP_GUIDE.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend Configuration (Optional)
VITE_API_URL=http://127.0.0.1:8000

# Database Configuration (Optional - defaults to SQLite)
# For production, consider using PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/voice_audit
